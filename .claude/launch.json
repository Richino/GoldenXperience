{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "goldenx-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "api-server", "run", "dev"],
      "port": 8787
    },
    {
      "name": "api-server-readonly",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set ENABLE_SCHEDULERS=false&& npm --workspace api-server run dev"],
      "port": 8787
    },
    {
      "name": "gx-mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8082"],
      "cwd": "gx-mobile",
      "port": 8082
    }
  ]
}
