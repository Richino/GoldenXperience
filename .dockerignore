# Keep the API Railpack context lean. research-v2 holds multi‑hundred‑MB
# audit caches and reports that are not needed to build or run production.
api-server/research-v2/

# Local research one-offs (underscore-prefixed) are not part of the API runtime.
api-server/scripts/_*.ts
api-server/scripts/_*.mjs
api-server/scripts/_*.py

# Frontend source is required: api-server typechecks against shared modules
# under frontend/src. Do not exclude the frontend tree from this build.

# Local / generated noise
**/node_modules
**/.next
**/dist
**/build
**/.git
**/*.log
**/.env
**/.env.*
graphify-out/
momentum-excursion-audit.csv
research-baseline-pre-ny.json
