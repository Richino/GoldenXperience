# The Railway-injected PORT is used automatically. Do not set it locally unless needed.
OANDA_ACCOUNT_ID=
OANDA_API_KEY=
# OANDA_API_TOKEN= # backward-compatible alias
OANDA_ENVIRONMENT=practice
OANDA_REQUEST_TIMEOUT_MS=8000

# Comma-separated web origins allowed to call this API from the browser.
# Set this to your Railway web URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: choose instruments broadcast by the WebSocket stream.
MARKET_STREAM_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY

# Required by the paper cycle, not optional despite the macro read being one
# point of eight. Without it macroBiasFor returns "neutral", which never equals
# a trade direction, so the scorecard's ceiling drops to exactly its pass mark
# and the overlap-session point silently becomes mandatory — entries are then
# impossible outside 12:00-16:00 UTC. Free key from https://fred.stlouisfed.org.
FRED_API_KEY=
