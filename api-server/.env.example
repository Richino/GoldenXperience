# The Railway-injected PORT is used automatically. Do not set it locally unless needed.
OANDA_ACCOUNT_ID=
OANDA_API_KEY=
# OANDA_API_TOKEN= # backward-compatible alias
OANDA_ENVIRONMENT=practice
OANDA_REQUEST_TIMEOUT_MS=8000

# Comma-separated web origins allowed to call this API from the browser.
# Set this to your Railway web URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: choose instruments broadcast by the WebSocket stream.
MARKET_STREAM_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY

# Required by the paper cycle, not optional despite the macro read being one
# point of eight. Without it macroBiasFor returns "neutral", which never equals
# a trade direction, so the scorecard's ceiling drops to exactly its pass mark
# and the overlap-session point silently becomes mandatory — entries are then
# impossible outside 12:00-16:00 UTC. Free key from https://fred.stlouisfed.org.
FRED_API_KEY=

# Optional. When true, opens shadow binary-logistic-v1 predictions alongside baseline for research.
# Default false — baseline UX and behavior are unchanged when off.
BINARY_LOGISTIC_SHADOW_ENABLED=false

# Optional. Enables adaptive selector analysis (COLLECTING/LEARNING/ACTIVE states).
# Default false — baseline remains authoritative when off.
BINARY_ADAPTIVE_SELECTOR_ENABLED=false

# Optional. Allows ACTIVE_SELECTION to grant logistic authority when evidence supports it.
# Requires BINARY_ADAPTIVE_SELECTOR_ENABLED=true and BINARY_LOGISTIC_SHADOW_ENABLED=true.
# Default false — even strong evidence only records recommendations until enabled.
BINARY_ADAPTIVE_LIVE_SELECTION_ENABLED=false

# Keep this pair stable; rotating it invalidates existing device subscriptions.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
