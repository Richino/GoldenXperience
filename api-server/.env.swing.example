# Merge the settings you need into the API environment. Credentials belong in
# the existing server environment; nothing here is a frontend secret/config.
# Defaults keep this new analysis system off until you explicitly enable it.
SWING_INTELLIGENCE_ENABLED=false
SWING_ANALYSIS_WORKER_ENABLED=false
SWING_INSTRUMENTS=EUR_USD
SWING_ENTRY_STYLE=BALANCED
SWING_HOLDING_DAYS=5
SWING_DAILY_RESEARCH_HOUR_UTC=6
SWING_HOURLY_NEWS_CHECKS=true
SWING_HOURLY_SEARCH_ENABLED=true
SWING_DAILY_RESEARCH_LIMIT=6
SWING_MAX_SEARCHES=3
SWING_RESEARCH_CACHE_HOURS=24
SWING_REASONING_EFFORT=low
SWING_RESEARCH_TIMEOUT_MS=300000
SWING_AI_REQUEST_RESERVE_USD=1
# Optional: overrides the existing OPENAI_RESEARCH_MODEL / OPENAI_ANALYSIS_MODEL.
# SWING_OPENAI_MODEL=
# Optional: requires the existing OPENAI_PRICE_* prices to be configured.
# SWING_MAX_AI_SPEND_USD=
SWING_MAX_RISK_PERCENT=1
SWING_MAX_AGGREGATE_RISK_PERCENT=3
SWING_MIN_REWARD_RISK=1.5
SWING_MIN_STOP_ATR=0.8
SWING_MAX_STOP_ATR=4
SWING_STOP_BUFFER_ATR=0.2
SWING_ZONE_MIN_WIDTH_ATR=0.15
SWING_ZONE_MAX_WIDTH_ATR=0.8
SWING_ZONE_TTL_TRADING_HOURS=120
SWING_MOVEMENT_WINDOWS=15,60,300,900
SWING_MAX_QUOTE_SAMPLES=12000
SWING_QUOTE_MAX_AGE_MS=5000
SWING_STRUCTURE_REFRESH_MS=60000
SWING_ACCOUNT_REFRESH_MS=30000
SWING_AGGREGATE_SECONDS=60
SWING_AGGREGATE_RETENTION_DAYS=30
# The analysis worker is independent of ENABLE_SCHEDULERS. On an isolated API
# used only for manual review, the existing ENABLE_SCHEDULERS=false setting can
# remain in place. These flags never enable an order executor.
