//@version=6
strategy(
     "GX NZDJPY 23UTC Bull Break V1 - 1 to 2 RR",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_bars_back=5000,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// ============================================================
// NZDJPY 23UTC BULL BREAK V1
//
// PAIR:
// OANDA:NZDJPY
//
// TIMEFRAME:
// H1
//
// FROZEN RESEARCH:
//
// Phase 1:
// Primary cluster = 22:00-00:00 UTC
// Selected origin = 23:00 UTC
//
// Phase 2:
// LONG only
// 4-vote consensus >= +3
// LONG accuracy = 58.14%
//
// Phase 3:
// prev-high break + body/extreme
//
// Phase 4:
// Added 0.10 ATR clearance above previous H1 high
//
// Diagnostic:
//
// 45 trades
// 57.78% WR
// PF 1.903
// +0.349R/trade
//
// EXIT:
// SL = 1 frozen ATR14
// TP = 2 frozen ATR14
// MAX HOLD = 3 future H1 bars
// ============================================================

EMA_FAST = 20
EMA_SLOW = 50
ATR_LEN = 14

ORIGIN_HOUR = 23
CONSENSUS_MIN = 3

BODY_ATR_MIN = 0.50
EXTREME_PCT = 0.25
BREAK_CLEARANCE_R = 0.10

STOP_R = 1.0
TARGET_R = 2.0
MAX_HOLD_BARS = 3

// ============================================================
// INPUTS
// ============================================================

startTime = input.time(
     timestamp("01 Jan 2023 00:00 +0000"),
     "Start date")

showMarkers = input.bool(
     true,
     "Show entries")

// ============================================================
// CHART VALIDATION
// ============================================================

isH1 =
     timeframe.isminutes and
     timeframe.multiplier == 60

tickerUpper =
     str.upper(syminfo.ticker)

isNZDJPY =
     str.contains(tickerUpper, "NZDJPY")

validChart =
     isH1 and isNZDJPY

// ============================================================
// INDICATORS
// ============================================================

ema20 =
     ta.ema(close, EMA_FAST)

ema50 =
     ta.ema(close, EMA_SLOW)

atr14 =
     ta.atr(ATR_LEN)

// ============================================================
// TIME
// ============================================================

utcHour =
     hour(time, "UTC")

utcMinute =
     minute(time, "UTC")

isOrigin =
     validChart and
     barstate.isconfirmed and
     utcHour == ORIGIN_HOUR and
     utcMinute == 0 and
     time >= startTime

ready =
     isOrigin and
     not na(ema20) and
     not na(ema50) and
     not na(ema20[3]) and
     not na(close[3]) and
     not na(high[1]) and
     not na(atr14) and
     atr14 > 0

// ============================================================
// FOUR-VOTE CONSENSUS
// ============================================================

int voteTrend = 0
int votePrice = 0
int voteSlope = 0
int voteMomentum = 0

if ready

    voteTrend :=
         ema20 > ema50 ? 1 :
         ema20 < ema50 ? -1 :
         0

    votePrice :=
         close > ema20 ? 1 :
         close < ema20 ? -1 :
         0

    voteSlope :=
         ema20 > ema20[3] ? 1 :
         ema20 < ema20[3] ? -1 :
         0

    voteMomentum :=
         close > close[3] ? 1 :
         close < close[3] ? -1 :
         0

consensus =
     voteTrend +
     votePrice +
     voteSlope +
     voteMomentum

bullConsensus =
     ready and
     consensus >= CONSENSUS_MIN

// ============================================================
// BODY + EXTREME
// ============================================================

body =
     math.abs(close - open)

candleRange =
     high - low

bullBody =
     close > open

strongBody =
     body >= BODY_ATR_MIN * atr14

upperExtreme =
     candleRange > 0 and
     close >=
     high - candleRange * EXTREME_PCT

bodyExtreme =
     bullBody and
     strongBody and
     upperExtreme

// ============================================================
// FROZEN BREAKOUT
//
// Must clear previous H1 high by >= 0.10 ATR.
// ============================================================

breakDistance =
     close - high[1]

strongPrevHighBreak =
     breakDistance >=
     BREAK_CLEARANCE_R * atr14

// ============================================================
// FINAL SIGNAL
// ============================================================

longSignal =
     bullConsensus and
     bodyExtreme and
     strongPrevHighBreak

// ============================================================
// TRADE STATE
// ============================================================

var bool tradeActive = false

var float frozenEntry = na
var float frozenATR = na
var float frozenStop = na
var float frozenTarget = na

var int entryBar = na

bool executedLong = false

// ============================================================
// RESET AFTER TRADE CLOSE
// ============================================================

if tradeActive and
   not na(entryBar) and
   bar_index > entryBar and
   strategy.position_size == 0

    tradeActive := false

    frozenEntry := na
    frozenATR := na
    frozenStop := na
    frozenTarget := na

    entryBar := na

// ============================================================
// ENTRY
// ============================================================

canLong =
     longSignal and
     not tradeActive and
     strategy.position_size == 0

if canLong

    frozenEntry :=
         close

    frozenATR :=
         atr14

    frozenStop :=
         frozenEntry -
         STOP_R * frozenATR

    frozenTarget :=
         frozenEntry +
         TARGET_R * frozenATR

    entryBar :=
         bar_index

    tradeActive :=
         true

    executedLong :=
         true

    strategy.entry(
         "NZDJPY_LONG",
         strategy.long,
         comment="NZDJPY_2300_LONG")

    strategy.exit(
         "NZDJPY_EXIT",
         from_entry="NZDJPY_LONG",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")

// ============================================================
// KEEP FROZEN STOP / TARGET ACTIVE
// ============================================================

if tradeActive

    strategy.exit(
         "NZDJPY_EXIT",
         from_entry="NZDJPY_LONG",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")

// ============================================================
// TIME EXIT
//
// 23:00 = signal
// 00:00 = future #1
// 01:00 = future #2
// 02:00 = future #3
// ============================================================

if tradeActive and
   not na(entryBar)

    barsHeld =
         bar_index - entryBar

    if barsHeld >= MAX_HOLD_BARS

        strategy.close(
             "NZDJPY_LONG",
             comment="TIME_EXIT")

// ============================================================
// VISUALS
// ============================================================

plot(
     ema20,
     "EMA20")

plot(
     ema50,
     "EMA50")

plotshape(
     showMarkers and
     executedLong,
     title="NZDJPY LONG",
     text="LONG",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.tiny)

// ============================================================
// INFO
// ============================================================

var table info =
     table.new(
          position.top_right,
          2,
          10,
          border_width=1)

if barstate.islast

    table.cell(info, 0, 0, "NZDJPY")
    table.cell(info, 1, 0, "V1")

    table.cell(info, 0, 1, "Origin")
    table.cell(info, 1, 1, "23:00 UTC")

    table.cell(info, 0, 2, "Direction")
    table.cell(info, 1, 2, "LONG ONLY")

    table.cell(info, 0, 3, "Consensus")
    table.cell(info, 1, 3, ">= +3")

    table.cell(info, 0, 4, "Break")
    table.cell(info, 1, 4, "HIGH[1] + .10ATR")

    table.cell(info, 0, 5, "Body")
    table.cell(info, 1, 5, ">= .50 ATR")

    table.cell(info, 0, 6, "Close")
    table.cell(info, 1, 6, "UPPER 25%")

    table.cell(info, 0, 7, "SL")
    table.cell(info, 1, 7, "1 ATR")

    table.cell(info, 0, 8, "TP")
    table.cell(info, 1, 8, "2 ATR")

    table.cell(info, 0, 9, "Hold")
    table.cell(info, 1, 9, "3 H1")

bgcolor(
     validChart ?
     na :
     color.new(color.red, 90))