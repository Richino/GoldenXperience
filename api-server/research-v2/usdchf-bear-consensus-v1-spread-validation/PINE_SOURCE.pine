//@version=6

strategy(
     "GX USDCHF Bear Consensus Structure V1 - 1 to 2 RR",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_bars_back=5000,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// ============================================================
// USDCHF BEAR CONSENSUS STRUCTURE V1
//
// PHASE 1:
// Strong movement window = 10:00-12:00 UTC
// Primary origin         = 11:00 UTC
//
// PHASE 2:
// SHORT only
//
// Four-vote bearish consensus <= -3:
//
// 1. EMA20 vs EMA50
// 2. Close vs EMA20
// 3. EMA20 slope over 3 bars
// 4. Close vs close[3]
//
// PHASE 3:
// Bearish structure:
//
// current high < previous high
// AND
// current low < previous low
//
// PHASE 4:
// NO additional breakthrough filter.
//
// FROZEN DIAGNOSTIC RESULT:
//
// 103 trades
// 49.51% WR
// PF 1.913
// +0.408R/trade midpoint
//
// EXECUTION:
//
// Entry = completed 11:00 UTC close
// Stop = 1 frozen ATR14
// Target = 2 frozen ATR14
// Max hold = 3 future H1 bars
//
// SHORT ONLY.
// ============================================================


// ============================================================
// CONSTANTS
// ============================================================

EMA_FAST = 20
EMA_SLOW = 50
ATR_LEN = 14

ORIGIN_HOUR = 11

CONSENSUS_MIN = 3

STOP_R = 1.0
TARGET_R = 2.0
MAX_HOLD_BARS = 3


// ============================================================
// INPUTS
// ============================================================

startTime = input.time(
     timestamp("01 Jan 2023 00:00 +0000"),
     "Start date")

showMarkers = input.bool(
     true,
     "Show Entries")


// ============================================================
// CHART VALIDATION
// ============================================================

isH1 =
     timeframe.isminutes and
     timeframe.multiplier == 60

tickerUpper =
     str.upper(syminfo.ticker)

isUSDCHF =
     str.contains(tickerUpper, "USDCHF")

validChart =
     isH1 and isUSDCHF


// ============================================================
// INDICATORS
// ============================================================

ema20 =
     ta.ema(close, EMA_FAST)

ema50 =
     ta.ema(close, EMA_SLOW)

atr14 =
     ta.atr(ATR_LEN)


// ============================================================
// UTC
// ============================================================

utcHour =
     hour(time, "UTC")

utcMinute =
     minute(time, "UTC")


// ============================================================
// ORIGIN
// ============================================================

isOrigin =
     validChart and
     barstate.isconfirmed and
     utcHour == ORIGIN_HOUR and
     utcMinute == 0 and
     time >= startTime


// ============================================================
// READINESS
// ============================================================

ready =
     isOrigin and
     not na(ema20) and
     not na(ema50) and
     not na(atr14) and
     not na(ema20[3]) and
     not na(close[3]) and
     not na(high[1]) and
     not na(low[1]) and
     atr14 > 0


// ============================================================
// FOUR-VOTE CONSENSUS
// ============================================================

int voteTrend = 0
int votePrice = 0
int voteSlope = 0
int voteMomentum = 0

if ready

    voteTrend :=
         ema20 < ema50 ?
         -1 :
         ema20 > ema50 ?
         1 :
         0

    votePrice :=
         close < ema20 ?
         -1 :
         close > ema20 ?
         1 :
         0

    voteSlope :=
         ema20 < ema20[3] ?
         -1 :
         ema20 > ema20[3] ?
         1 :
         0

    voteMomentum :=
         close < close[3] ?
         -1 :
         close > close[3] ?
         1 :
         0


consensus =
     voteTrend +
     votePrice +
     voteSlope +
     voteMomentum


bearishConsensus =
     ready and
     consensus <= -CONSENSUS_MIN


// ============================================================
// BEARISH STRUCTURE
// ============================================================

bearStructure =
     high < high[1] and
     low < low[1]


// ============================================================
// FINAL FROZEN SIGNAL
// ============================================================

rawShortSignal =
     bearishConsensus and
     bearStructure


// ============================================================
// TRADE STATE
// ============================================================

var bool tradeActive = false

var float frozenEntry = na
var float frozenATR = na
var float frozenStop = na
var float frozenTarget = na

var int entryBar = na

bool executedShort = false


// ============================================================
// CLEAR CLOSED STATE
// ============================================================

if tradeActive and
   not na(entryBar) and
   bar_index > entryBar and
   strategy.position_size == 0

    tradeActive := false

    frozenEntry := na
    frozenATR := na
    frozenStop := na
    frozenTarget := na

    entryBar := na


// ============================================================
// SHORT ENTRY
// ============================================================

canShort =
     rawShortSignal and
     not tradeActive and
     strategy.position_size == 0

if canShort

    frozenEntry :=
         close

    frozenATR :=
         atr14

    frozenStop :=
         frozenEntry +
         frozenATR * STOP_R

    frozenTarget :=
         frozenEntry -
         frozenATR * TARGET_R

    entryBar :=
         bar_index

    tradeActive :=
         true

    executedShort :=
         true


    strategy.entry(
         "USDCHF_SHORT",
         strategy.short,
         comment="USDCHF_1100_SHORT")


    strategy.exit(
         "USDCHF_SHORT_EXIT",
         from_entry="USDCHF_SHORT",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")


// ============================================================
// MAINTAIN FROZEN SL / TP
// ============================================================

if tradeActive

    strategy.exit(
         "USDCHF_SHORT_EXIT",
         from_entry="USDCHF_SHORT",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")


// ============================================================
// TIME EXIT
//
// 11:00 = origin / entry
// 12:00 = future #1
// 13:00 = future #2
// 14:00 = future #3
// ============================================================

if tradeActive and
   not na(entryBar)

    barsHeld =
         bar_index - entryBar

    if barsHeld >= MAX_HOLD_BARS

        strategy.close(
             "USDCHF_SHORT",
             comment="TIME_EXIT")


// ============================================================
// VISUALS
// ============================================================

plot(
     ema20,
     "EMA20")

plot(
     ema50,
     "EMA50")

plotshape(
     showMarkers and executedShort,
     title="USDCHF SHORT",
     text="SHORT",
     style=shape.triangledown,
     location=location.abovebar,
     size=size.tiny)


// ============================================================
// INFO
// ============================================================

var table info =
     table.new(
          position.top_right,
          2,
          8,
          border_width=1)

if barstate.islast

    table.cell(info, 0, 0, "USDCHF")
    table.cell(info, 1, 0, "V1")

    table.cell(info, 0, 1, "Origin")
    table.cell(info, 1, 1, "11:00 UTC")

    table.cell(info, 0, 2, "Direction")
    table.cell(info, 1, 2, "SHORT ONLY")

    table.cell(info, 0, 3, "Trend")
    table.cell(info, 1, 3, "4-VOTE <= -3")

    table.cell(info, 0, 4, "Structure")
    table.cell(info, 1, 4, "LH + LL")

    table.cell(info, 0, 5, "SL")
    table.cell(info, 1, 5, "1 ATR14")

    table.cell(info, 0, 6, "TP")
    table.cell(info, 1, 6, "2 ATR14")

    table.cell(info, 0, 7, "Hold")
    table.cell(info, 1, 7, "3 H1")


// ============================================================
// WRONG CHART
// ============================================================

bgcolor(
     validChart ?
     na :
     color.new(color.red, 90))