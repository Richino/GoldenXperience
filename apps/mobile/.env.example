# GoldenXperience Mobile — environment
#
# Only EXPO_PUBLIC_* values are readable by the app at runtime and are bundled
# into the client. NEVER put a server secret (OANDA keys, database URL, VAPID
# private key) here — those stay on the GX API server. The mobile app talks only
# to the GX API, which holds all broker credentials.

# Origin of the existing GX API server (HTTP + WebSocket live on the same host).
# On a simulator, localhost reaches the dev machine. On a PHYSICAL device it does
# not — use the dev machine's LAN address so the phone can reach the API.
#   Simulator: http://localhost:8787
#   Device:    http://192.168.1.50:8787   (your machine's LAN IP)
EXPO_PUBLIC_GX_API_URL=http://localhost:8787

# Optional. Override the market-stream WebSocket origin. Leave unset to derive it
# from EXPO_PUBLIC_GX_API_URL (http→ws). Set only if the stream is on another host.
# EXPO_PUBLIC_GX_WS_URL=ws://localhost:8787
