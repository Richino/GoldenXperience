{
  "name": "@gx/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-cookies/cookies": "^6.2.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.21",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "comment": "Known Phase 1 tradeoff: the session cookie is read via @react-native-cookies/cookies, which needs the old architecture (newArchEnabled:false). Revisit with react-native-nitro-cookies when moving to the New Architecture.",
        "exclude": [
          "@react-native-cookies/cookies"
        ]
      }
    }
  }
}
