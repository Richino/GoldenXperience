# OANDA practice credentials. Never prefix these with NEXT_PUBLIC_.
OANDA_ACCOUNT_ID=
OANDA_API_KEY=
# Backward-compatible alias also supported by the app:
# OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice

# Optional request timeout in milliseconds.
OANDA_REQUEST_TIMEOUT_MS=8000

# Railway API server. API_SERVER_URL may use Railway's private service URL;
# NEXT_PUBLIC_API_SERVER_URL must be the browser-reachable public URL.
API_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_API_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_MARKET_STREAM_WS_URL=ws://localhost:8787

# Paper simulation guard. This is public because it is not a broker credential.
# Raw risk sizing is still shown, but displayed paper size is capped at this value.
NEXT_PUBLIC_PAPER_MAX_STANDARD_LOTS=2
