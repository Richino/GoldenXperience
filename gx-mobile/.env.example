# Public HTTPS URL where the GX web app is deployed (Next.js).
# Use the SAME value for both vars so login cookies work in the chart WebView
# (API requests go through Next's /api rewrite on that host).
#
# Production (EAS builds also set this in eas.json):
# EXPO_PUBLIC_API_URL=https://goldenxperience.com
# EXPO_PUBLIC_WEB_APP_URL=https://goldenxperience.com
#
# Leave unset for local dev (LAN IP in src/lib/api/config.ts).

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_APP_URL=
