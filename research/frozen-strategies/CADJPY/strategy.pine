//@version=6
strategy(
     "GX CADJPY Bull Break Extreme V1 - 1 to 2 RR",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_bars_back=5000,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// ============================================================
// CADJPY BULL BREAK EXTREME V1
//
// SYMBOL:
// OANDA:CADJPY
//
// TIMEFRAME:
// H1
//
// FROZEN DEVELOPMENT:
//
// Phase 1:
// Primary movement cluster = 10:00-13:00 UTC
// Selected branch = 12:00 UTC
//
// Phase 2B:
// LONG ONLY
// 4-vote consensus >= +3
//
// Phase 3B:
// close > previous H1 high
// bullish body >= 0.50 ATR14
// close in upper 25% of candle
//
// Phase 4B:
// REJECTED.
// 07-11 range breakout improved expectancy only
// +0.319R -> +0.329R while reducing 84 -> 64 trades.
//
// FROZEN DIAGNOSTIC:
//
// 84 trades
// 54.76% WR
// PF 1.729
// +0.319R/trade
//
// EXIT:
// SL = 1 frozen ATR14
// TP = 2 frozen ATR14
// Hold = 3 future H1 bars
// ============================================================

EMA_FAST = 20
EMA_SLOW = 50
ATR_LEN = 14

ORIGIN_HOUR = 12
CONSENSUS_MIN = 3

BODY_ATR_MIN = 0.50
EXTREME_PCT = 0.25

STOP_R = 1.0
TARGET_R = 2.0
MAX_HOLD_BARS = 3

// ============================================================
// INPUTS
// ============================================================

startTime = input.time(
     timestamp("01 Jan 2023 00:00 +0000"),
     "Start date")

showMarkers = input.bool(
     true,
     "Show entries")

// ============================================================
// CHART
// ============================================================

isH1 =
     timeframe.isminutes and
     timeframe.multiplier == 60

tickerUpper =
     str.upper(syminfo.ticker)

isCADJPY =
     str.contains(tickerUpper, "CADJPY")

validChart =
     isH1 and isCADJPY

// ============================================================
// INDICATORS
// ============================================================

ema20 =
     ta.ema(close, EMA_FAST)

ema50 =
     ta.ema(close, EMA_SLOW)

atr14 =
     ta.atr(ATR_LEN)

// ============================================================
// TIME
// ============================================================

utcHour =
     hour(time, "UTC")

utcMinute =
     minute(time, "UTC")

isOrigin =
     validChart and
     barstate.isconfirmed and
     utcHour == ORIGIN_HOUR and
     utcMinute == 0 and
     time >= startTime

// ============================================================
// READINESS
// ============================================================

ready =
     isOrigin and
     not na(ema20) and
     not na(ema50) and
     not na(ema20[3]) and
     not na(close[3]) and
     not na(high[1]) and
     not na(atr14) and
     atr14 > 0

// ============================================================
// FOUR-VOTE CONSENSUS
// ============================================================

int voteTrend = 0
int votePrice = 0
int voteSlope = 0
int voteMomentum = 0

if ready

    voteTrend :=
         ema20 > ema50 ? 1 :
         ema20 < ema50 ? -1 :
         0

    votePrice :=
         close > ema20 ? 1 :
         close < ema20 ? -1 :
         0

    voteSlope :=
         ema20 > ema20[3] ? 1 :
         ema20 < ema20[3] ? -1 :
         0

    voteMomentum :=
         close > close[3] ? 1 :
         close < close[3] ? -1 :
         0

consensus =
     voteTrend +
     votePrice +
     voteSlope +
     voteMomentum

bullConsensus =
     ready and
     consensus >= CONSENSUS_MIN

// ============================================================
// PREVIOUS HIGH BREAK
// ============================================================

prevHighBreak =
     close > high[1]

// ============================================================
// BODY + EXTREME
// ============================================================

body =
     math.abs(close - open)

candleRange =
     high - low

bullBody =
     close > open

strongBody =
     body >=
     BODY_ATR_MIN * atr14

upperExtreme =
     candleRange > 0 and
     close >=
     high - candleRange * EXTREME_PCT

bodyExtreme =
     bullBody and
     strongBody and
     upperExtreme

// ============================================================
// FINAL SIGNAL
// ============================================================

longSignal =
     bullConsensus and
     prevHighBreak and
     bodyExtreme

// ============================================================
// TRADE STATE
// ============================================================

var bool tradeActive = false

var float frozenEntry = na
var float frozenATR = na
var float frozenStop = na
var float frozenTarget = na

var int entryBar = na

bool executedLong = false

// ============================================================
// RESET AFTER CLOSED TRADE
// ============================================================

if tradeActive and
   not na(entryBar) and
   bar_index > entryBar and
   strategy.position_size == 0

    tradeActive := false

    frozenEntry := na
    frozenATR := na
    frozenStop := na
    frozenTarget := na

    entryBar := na

// ============================================================
// ENTRY
// ============================================================

canLong =
     longSignal and
     not tradeActive and
     strategy.position_size == 0

if canLong

    frozenEntry :=
         close

    frozenATR :=
         atr14

    frozenStop :=
         frozenEntry -
         frozenATR * STOP_R

    frozenTarget :=
         frozenEntry +
         frozenATR * TARGET_R

    entryBar :=
         bar_index

    tradeActive :=
         true

    executedLong :=
         true

    strategy.entry(
         "CADJPY_LONG",
         strategy.long,
         comment="CADJPY_1200_LONG")

    strategy.exit(
         "CADJPY_EXIT",
         from_entry="CADJPY_LONG",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")

// ============================================================
// MAINTAIN FROZEN STOP / TARGET
// ============================================================

if tradeActive

    strategy.exit(
         "CADJPY_EXIT",
         from_entry="CADJPY_LONG",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")

// ============================================================
// TIME EXIT
//
// 12:00 = entry
// 13:00 = future #1
// 14:00 = future #2
// 15:00 = future #3
// ============================================================

if tradeActive and
   not na(entryBar)

    barsHeld =
         bar_index - entryBar

    if barsHeld >= MAX_HOLD_BARS

        strategy.close(
             "CADJPY_LONG",
             comment="TIME_EXIT")

// ============================================================
// VISUALS
// ============================================================

plot(
     ema20,
     "EMA20")

plot(
     ema50,
     "EMA50")

plotshape(
     showMarkers and executedLong,
     title="CADJPY LONG",
     text="LONG",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.tiny)

// ============================================================
// INFO
// ============================================================

var table info =
     table.new(
          position.top_right,
          2,
          9,
          border_width=1)

if barstate.islast

    table.cell(info, 0, 0, "CADJPY")
    table.cell(info, 1, 0, "V1")

    table.cell(info, 0, 1, "Origin")
    table.cell(info, 1, 1, "12:00 UTC")

    table.cell(info, 0, 2, "Direction")
    table.cell(info, 1, 2, "LONG ONLY")

    table.cell(info, 0, 3, "Trend")
    table.cell(info, 1, 3, "4-VOTE >= +3")

    table.cell(info, 0, 4, "Break")
    table.cell(info, 1, 4, "PREV HIGH")

    table.cell(info, 0, 5, "Body")
    table.cell(info, 1, 5, ">= 0.50 ATR")

    table.cell(info, 0, 6, "Close")
    table.cell(info, 1, 6, "UPPER 25%")

    table.cell(info, 0, 7, "SL / TP")
    table.cell(info, 1, 7, "1R / 2R")

    table.cell(info, 0, 8, "Hold")
    table.cell(info, 1, 8, "3 H1")

bgcolor(
     validChart ?
     na :
     color.new(color.red, 90))