//@version=6

strategy(
     "GX USDCAD Structure EMA Reclaim V3 - 11:00 LONG Only - 1 to 2 RR",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_bars_back=5000,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// ============================================================
// USDCAD V3
//
// FROZEN CANDIDATE FROM EXECUTION VALIDATION:
//
// ONLY:
// 11:00 UTC LONG
//
// PRIOR V2 EXEC RESULT:
//
// 11:00 LONG:
// 49 trades
// EXEC WR 48.98%
// EXEC PF 1.397
// EXEC expectancy +0.214R
//
// Earlier selected origins are DISABLED.
//
// 09:00 LONG  = disabled
// 10:00 SHORT = disabled
// 11:00 SHORT = disabled
//
// CORE RULES UNCHANGED:
//
// LONG:
// HH + HL
// previous close <= previous EMA20
// current close > current EMA20
//
// Entry = completed 11:00 H1 close
// Stop = 1 ATR14
// Target = 2 ATR14
// Max hold = 3 future H1 bars
//
// PEN + EXTREME remains metadata ONLY.
// ============================================================


// ============================================================
// CONSTANTS
// ============================================================

EMA_LEN = 20
ATR_LEN = 14

ORIGIN_HOUR = 11

STOP_ATR = 1.0
TARGET_R = 2.0
MAX_HOLD_BARS = 3

EMA_PEN_ATR_MIN = 0.25
EXTREME_CLOSE_PCT = 0.25


// ============================================================
// DISPLAY
// ============================================================

showMarkers = input.bool(true, "Show Entries")


// ============================================================
// INDICATORS
// ============================================================

ema20 = ta.ema(close, EMA_LEN)
atr14 = ta.atr(ATR_LEN)


// ============================================================
// CHART VALIDATION
// ============================================================

isUSDCAD =
     syminfo.basecurrency == "USD" and
     syminfo.currency == "CAD"

isH1 =
     timeframe.isminutes and
     timeframe.multiplier == 60

validChart =
     isUSDCAD and isH1


// ============================================================
// UTC
// ============================================================

utcHour = hour(time, "UTC")
utcMinute = minute(time, "UTC")


// ============================================================
// ORIGIN
// ============================================================

isOrigin =
     validChart and
     barstate.isconfirmed and
     utcHour == ORIGIN_HOUR and
     utcMinute == 0


// ============================================================
// READINESS
// ============================================================

indicatorsReady =
     not na(ema20) and
     not na(ema20[1]) and
     not na(atr14) and
     atr14 > 0

historyReady =
     isOrigin and
     not na(high[1]) and
     not na(low[1]) and
     not na(close[1])

originReady =
     isOrigin and
     indicatorsReady and
     historyReady


// ============================================================
// BULLISH STRUCTURE
// ============================================================

bullStructure =
     high > high[1] and
     low > low[1]


// ============================================================
// EMA20 RECLAIM
// ============================================================

longReclaim =
     close[1] <= ema20[1] and
     close > ema20


// ============================================================
// LONG SIGNAL
// ============================================================

rawLongSignal =
     originReady and
     bullStructure and
     longReclaim


// ============================================================
// HIGH-CONFIDENCE METADATA
// ============================================================

candleRange =
     high - low

emaPenetrationLong =
     close - ema20

emaPenLong =
     emaPenetrationLong >=
     EMA_PEN_ATR_MIN * atr14

extremeLong =
     candleRange > 0 and
     close >=
     high -
     candleRange * EXTREME_CLOSE_PCT

highConfidenceLong =
     rawLongSignal and
     emaPenLong and
     extremeLong


// ============================================================
// TRADE STATE
// ============================================================

var bool tradeActive = false

var float frozenEntry = na
var float frozenATR = na
var float frozenStop = na
var float frozenTarget = na

var int entryBar = na
var string activeTag = ""

bool executedBase = false
bool executedHigh = false


// ============================================================
// CLEAR CLOSED STATE
// ============================================================

if tradeActive and
   not na(entryBar) and
   bar_index > entryBar and
   strategy.position_size == 0

    tradeActive := false

    frozenEntry := na
    frozenATR := na
    frozenStop := na
    frozenTarget := na

    entryBar := na
    activeTag := ""


// ============================================================
// ENTRY
// ============================================================

canEnter =
     rawLongSignal and
     not tradeActive and
     strategy.position_size == 0

if canEnter

    frozenEntry := close
    frozenATR := atr14

    frozenStop :=
         frozenEntry -
         frozenATR * STOP_ATR

    frozenTarget :=
         frozenEntry +
         frozenATR * TARGET_R

    entryBar := bar_index
    tradeActive := true


    if highConfidenceLong

        activeTag :=
             "USDCAD_1100_LONG_PEN_EXTREME"

        executedHigh := true

        strategy.entry(
             "USDCAD_1100_LONG",
             strategy.long,
             comment=activeTag)

    else

        activeTag :=
             "USDCAD_1100_LONG_BASE"

        executedBase := true

        strategy.entry(
             "USDCAD_1100_LONG",
             strategy.long,
             comment=activeTag)


    strategy.exit(
         "USDCAD_1100_LONG_EXIT",
         from_entry="USDCAD_1100_LONG",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")


// ============================================================
// MAINTAIN FROZEN SL / TP
// ============================================================

if tradeActive

    strategy.exit(
         "USDCAD_1100_LONG_EXIT",
         from_entry="USDCAD_1100_LONG",
         stop=frozenStop,
         limit=frozenTarget,
         comment="TP_OR_SL")


// ============================================================
// TIME EXIT
//
// 11:00 entry
// 12:00 = future #1
// 13:00 = future #2
// 14:00 = future #3
// ============================================================

if tradeActive and
   not na(entryBar)

    barsHeld =
         bar_index - entryBar

    if barsHeld >= MAX_HOLD_BARS

        strategy.close(
             "USDCAD_1100_LONG",
             comment="TIME_EXIT")


// ============================================================
// VISUALS
// ============================================================

plot(
     ema20,
     "EMA 20")

plotshape(
     showMarkers and executedBase,
     title="11:00 LONG BASE",
     text="L BASE",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.tiny)

plotshape(
     showMarkers and executedHigh,
     title="11:00 LONG HIGH",
     text="L HIGH",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.tiny)


// ============================================================
// INFO
// ============================================================

var table info =
     table.new(
          position.top_right,
          2,
          6,
          border_width=1)

if barstate.islast

    table.cell(info, 0, 0, "USDCAD")
    table.cell(info, 1, 0, "V3")

    table.cell(info, 0, 1, "Origin")
    table.cell(info, 1, 1, "11:00 UTC")

    table.cell(info, 0, 2, "Direction")
    table.cell(info, 1, 2, "LONG ONLY")

    table.cell(info, 0, 3, "Structure")
    table.cell(info, 1, 3, "HH + HL")

    table.cell(info, 0, 4, "SL / TP")
    table.cell(info, 1, 4, "1 ATR / 2 ATR")

    table.cell(info, 0, 5, "Max hold")
    table.cell(info, 1, 5, "3 H1")


// ============================================================
// WRONG CHART
// ============================================================

bgcolor(
     validChart ?
     na :
     color.new(color.red, 90))